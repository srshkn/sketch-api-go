# -------------------------------------------------------------------------
# SERVER

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SHOTDOWN_TIMEOUT_SECOND=10

# -------------------------------------------------------------------------
# LOGGER ["dev", "local", "prod"]

LOGGER_FORMAT=dev

# -------------------------------------------------------------------------
# PostgreSQL

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=SketchAPIonGo

MAX_OPEN_CONNS=10
MIN_OPEN_CONNS=2
CONN_MAX_LIFETIME=1
MAX_CONN_IDLE_TIME=15

# -------------------------------------------------------------------------
# JWT

JWT_PATH_PRIVATE_KEY=/app/secrets/private.pem
JWT_PATH_PUBLIC_KEY=/app/secrets/public.pem

ACCESS_EXPIRES_MINUTES=15
REFRESH_EXPIRES_DAYS=30

JWT_ISSUER=my-service
JWT_AUDIENCE=my-api

# -------------------------------------------------------------------------
# CORS

CORS_ALLOWED_ORIGINS=http://localhost:3000

# [GET, POST, PUT, PATCH, DELETE, OPTIONS]
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# [true, fasle]
CORS_ALLOW_CREDENTIALS=true

# -------------------------------------------------------------------------
# Cookie

AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=

# [true, fasle]
AUTH_COOKIE_SECURE=true

# [true, fasle]
AUTH_COOKIE_HTTP_ONLY=true

# [default, lax, strict, none]
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_MAX_AGE=604800
